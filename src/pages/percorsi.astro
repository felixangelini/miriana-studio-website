---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/react/Nav';
import Footer from '../components/sections/Footer.astro';
import PercorsiHero from '../components/sections/percorsi/PercorsiHero.astro';
import PercorsiPrincipio from '../components/sections/percorsi/PercorsiPrincipio.astro';
import Percorso from '../components/sections/percorsi/Percorso.astro';
import PercorsiOrientarsi from '../components/sections/percorsi/PercorsiOrientarsi.astro';
import PercorsiAudit from '../components/sections/percorsi/PercorsiAudit.astro';
import PercorsiFaq from '../components/sections/percorsi/PercorsiFaq.astro';
---

<BaseLayout
  title="Percorsi — Miriana Studio"
  description="Percorsi di progetto per identità visiva e branding hospitality: Brand Foundation, Brand Identity e Brand Direction."
>
  <Nav client:load currentPath={Astro.url.pathname} />
  <main>
    <PercorsiHero />
    <PercorsiPrincipio />
    <Percorso
      id="foundation"
      index="01"
      title="Brand"
      italic="Foundation"
      lead="Le basi per costruire la tua identità."
      paragraphs={[
        'Dalla creazione del logo alla scelta di colori, caratteri e stile grafico, definiamo gli elementi fondamentali dell’immagine della tua struttura ricettiva: il punto di partenza su cui costruire e sviluppare il brand nel tempo.',
      ]}
      result="Una prima base visiva, chiara e riconoscibile, pronta a evolvere con il progetto."
      cta
    />
    <Percorso
      id="identity"
      index="02"
      title="Brand"
      italic="Identity"
      lead="Una strategia precisa. Un’identità riconoscibile."
      paragraphs={[
        'Analizziamo il mercato e il contesto della struttura per definire il suo posizionamento, la personalità e il tono di voce.',
        'Da qui costruiamo un’identità visiva completa, dal logo al sistema grafico, con una direzione chiara per tutta la comunicazione.',
      ]}
      result="Un brand pronto a presentarsi sul mercato con un’immagine riconoscibile e una comunicazione coerente."
      tone="sand"
      cta
    />
    <Percorso
      id="direction"
      index="03"
      title="Brand"
      italic="Direction"
      lead="Per portare l’identità nei punti di contatto."
      paragraphs={[
        'Oltre alla strategia e all’identità visiva, un affiancamento nei primi mesi di comunicazione del brand.',
        'Dalla scelta delle immagini e dei materiali alle prime applicazioni, definiamo insieme come tradurre l’identità nei diversi canali, guidando le scelte creative e il lavoro del team.',
      ]}
      result="Una comunicazione avviata con una direzione chiara e coerente con l’identità del brand."
      cta
    />
    <PercorsiOrientarsi />
    <PercorsiAudit />
    <PercorsiFaq />
  </main>
  <Footer />
</BaseLayout>
