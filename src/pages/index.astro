---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/react/Nav';
import Hero from '../components/sections/Hero.astro';
import PuntoDiPartenza from '../components/sections/PuntoDiPartenza.astro';
import Lavori from '../components/sections/Lavori.astro';
import Direzione from '../components/sections/Direzione.astro';
import Studio from '../components/sections/Studio.astro';
import ComeLavoro from '../components/sections/ComeLavoro.astro';
import Cta from '../components/sections/Cta.astro';
import Footer from '../components/sections/Footer.astro';
---

<BaseLayout>
  <Nav client:load />
  <main>
    <Hero />
    <PuntoDiPartenza />
    <Lavori />
    <Direzione />
    <Studio />
    <ComeLavoro />
    <Cta />
  </main>
  <Footer />
</BaseLayout>
