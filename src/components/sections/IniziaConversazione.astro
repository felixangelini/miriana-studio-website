---
import Reveal from '../react/Reveal';
---

<Reveal client:visible className="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
  <p class="text-xl text-taupe">Inizia una conversazione.</p>
  <a
    href="/contatti"
    class="group inline-flex items-center gap-4 text-sm font-medium uppercase tracking-[2px] text-olive transition-opacity hover:opacity-70"
  >
    Parliamo del tuo progetto
    <span
      class="inline-block h-px w-8 origin-left bg-ink transition-[width] duration-300 ease-out group-hover:w-3"
      aria-hidden="true"
    ></span>
  </a>
</Reveal>
