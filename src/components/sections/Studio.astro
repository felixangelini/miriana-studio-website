---
import Reveal from '../react/Reveal';
import Parallax from '../react/Parallax';
---

<section
  id="studio"
  data-snap
  class="section-pad relative scroll-mt-20 bg-cream md:flex md:h-svh md:max-h-svh md:items-center md:overflow-x-clip md:overflow-y-hidden"
>
  <div class="relative mx-auto grid w-full max-w-site grid-cols-1 items-end gap-10 py-16 md:h-full md:max-h-full md:grid-cols-12 md:gap-6 md:pb-16 md:pt-8">
    <!-- Vertical label + line (desktop) -->
    <div
      class="absolute bottom-16 left-0 top-[38%] z-10 hidden flex-col items-center md:flex"
      aria-hidden="true"
    >
      <p
        class="shrink-0 text-[11px] font-medium uppercase tracking-[2px] text-olive [writing-mode:vertical-rl] rotate-180"
      >
        Lo studio
      </p>
      <span class="mt-4 w-px flex-1 bg-olive/70"></span>
    </div>

    <Reveal client:visible className="relative z-10 self-end pb-2 md:col-span-5 md:pb-8 md:pl-12">
      <p class="mb-4 text-[11px] font-medium uppercase tracking-[2px] text-olive md:hidden">
        Lo studio
      </p>

      <h2 class="font-display text-[clamp(1.85rem,3.2vw,2.5rem)] italic leading-tight text-terracotta">
        Miriana Amati
      </h2>
      <p class="font-script mt-0.5 origin-left rotate-[-6.75deg] text-[clamp(2rem,4vw,3.25rem)] leading-none text-olive">
        brand designer
      </p>

      <div class="mt-6 max-w-prose-md space-y-3 font-display text-[clamp(0.95rem,1.35vw,1.15rem)] leading-snug text-taupe md:mt-8">
        <p>
          Lavoro tra strategia e design per costruire identità visive capaci di rendere più chiaro e riconoscibile il valore di un brand.
        </p>
        <p>
          Il mio campo principale è l’hospitality, dove identità, comunicazione, materiali e spazio devono poter parlare la stessa lingua.
        </p>
      </div>

      <a
        href="/studio"
        class="group mt-6 inline-flex items-center gap-4 text-[13px] font-medium uppercase tracking-[2px] text-olive transition-opacity hover:opacity-70 md:mt-8"
      >
        Lo studio
        <span
          class="inline-block h-px w-8 origin-left bg-olive transition-[width] duration-300 ease-out group-hover:w-3"
          aria-hidden="true"
        ></span>
      </a>
    </Reveal>

    <Reveal
      client:visible
      delay={0.12}
      className="relative mx-auto self-end md:col-span-5 md:col-start-8 md:mx-0"
    >
      <div class="relative aspect-447/606 h-[min(68svh,32rem)] w-auto max-w-full overflow-visible bg-sand md:h-[min(74svh,34rem)]">
        <div class="absolute inset-0 overflow-hidden">
          <Parallax client:visible distance={64} className="h-full w-full">
            <img
              src="/images/studio-portrait.png"
              alt="Miriana Amati, brand designer"
              class="h-[112%] w-full object-cover object-[center_22%]"
              loading="lazy"
            />
          </Parallax>
        </div>
        <Parallax
          client:visible
          distance={36}
          reverse
          className="pointer-events-none absolute bottom-[3%] left-[42%] z-20 sm:left-[48%] lg:left-[52%]"
        >
          <p class="font-display text-[clamp(3rem,7vw,6rem)] leading-[0.95] text-olive">
            Miriana<br />
            Studio
          </p>
        </Parallax>
      </div>
    </Reveal>
  </div>
</section>
