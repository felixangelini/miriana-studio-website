---
import AuditForm from '../../react/AuditForm';
import Reveal from '../../react/Reveal';
---

<section class="section-pad bg-parchment py-24 md:py-32">
  <div class="mx-auto grid max-w-site items-start gap-12 md:grid-cols-12 md:gap-8">
    <Reveal client:visible className="md:col-span-2">
      <p class="text-[10px] font-medium uppercase tracking-[2px] text-ink/55">
        Mini audit / Risorsa
      </p>
    </Reveal>

    <Reveal client:visible delay={0.06} className="md:col-span-5">
      <h2 class="max-w-md font-display text-[clamp(2.4rem,4.5vw,3.75rem)] leading-[1.05] text-olive-soft">
        A che punto<br />
        è la <em class="italic">comunicazione</em><br />
        del tuo brand?
      </h2>
    </Reveal>

    <Reveal client:visible delay={0.12} className="md:col-span-5 md:pt-4">
      <p class="max-w-sm text-[13px] leading-relaxed text-ink/60">
        Un breve questionario per valutare lo stato attuale della tua comunicazione e capire da
        dove partire.
      </p>
      <AuditForm client:load />
    </Reveal>
  </div>
</section>
