---
import Reveal from '../../react/Reveal';
---

<section class="bg-cream-soft md:grid md:min-h-[min(100svh,60rem)] md:grid-cols-12">
  <div class="section-pad flex flex-col pb-12 pt-28 md:col-span-8 md:justify-between md:pb-16 md:pt-28">
    <Reveal client:visible onMount y={16} duration={0.8}>
      <div class="flex items-center justify-between border-t border-ink/20 pt-4">
        <p class="text-[10px] font-medium uppercase tracking-[2px] text-terracotta">
          Miriana Studio / Percorsi di progetto
        </p>
        <p class="text-[10px] font-medium uppercase tracking-[2px] text-ink/30"></p>
      </div>
    </Reveal>

    <Reveal client:visible onMount delay={0.12} y={36} duration={1} className="mt-16 md:mt-20">
      <h1 class="font-display text-[clamp(2.75rem,6.2vw,5rem)] leading-[0.95] text-terracotta">
        Un’identità
        <span class="mt-1 block font-script text-[clamp(3.4rem,8vw,7.5rem)] leading-none text-olive-soft">
          all’altezza
        </span>
        di ciò che<br />
        rappresenta.
      </h1>
    </Reveal>

    <div class="mt-16 grid items-end gap-8 md:mt-20 md:grid-cols-12">
      <Reveal client:visible delay={0.08} className="md:col-span-7 md:col-start-4">
        <p class="max-w-lg text-lg leading-relaxed text-taupe">
          Dalla strategia alla realizzazione del logo e dell’identità visiva per hotel, masserie e
          resort, fino alle applicazioni su sito web, social e materiali della struttura.
        </p>
      </Reveal>
      <Reveal client:visible delay={0.16} className="md:col-span-2 md:justify-self-end">
        <a
          href="#principio"
          class="text-[11px] font-medium uppercase tracking-[2px] text-olive-soft transition-opacity hover:opacity-70"
        >
          Esplora ↓
        </a>
      </Reveal>
    </div>
  </div>

  <div class="relative bg-sand md:col-span-4 md:min-h-full">
    <img
      src="/images/percorsi-hero.png"
      alt="Interno essenziale illuminato dalla luce naturale"
      class="h-72 w-full object-cover sm:h-96 md:absolute md:inset-0 md:h-full"
      fetchpriority="high"
    />
    <div class="absolute inset-x-0 bottom-0 flex items-start justify-between gap-4 bg-ink/20 p-6 md:p-8">
      <p class="text-[10px] font-medium uppercase tracking-[2px] text-cream/70">
        Spazio e identità
      </p>
      <p class="text-right text-[10px] font-medium uppercase tracking-[2px] text-cream/70">
        P. Czerwinski / Unsplash
      </p>
    </div>
  </div>
</section>
