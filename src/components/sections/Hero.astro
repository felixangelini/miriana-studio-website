---
import Reveal from '../react/Reveal';
---

<section
  id="top"
  data-snap
  class="relative flex h-svh max-h-svh flex-col overflow-hidden bg-cream lg:block"
>
  <div
    class="relative order-1 h-[32svh] max-h-[36svh] w-full shrink-0 overflow-hidden bg-sand lg:absolute lg:inset-y-0 lg:right-0 lg:order-0 lg:h-full lg:max-h-none lg:w-[40%]"
  >
    <Reveal client:load onMount x={-72} y={0} className="h-full w-full" delay={0.1} duration={1.6}>
      <img
        src="/images/hero-interior.png"
        alt="Interno architettonico con luce naturale"
        class="h-full w-full object-cover"
        fetchpriority="high"
      />
    </Reveal>
  </div>

  <div
    class="section-pad relative z-10 order-2 flex min-h-0 flex-1 flex-col justify-center py-6 lg:order-0 lg:h-full lg:w-[60%] lg:py-8 lg:pt-24"
  >
    <p class="mb-6 flex flex-wrap items-baseline gap-x-2 text-xs font-medium uppercase tracking-[2px] text-olive md:mb-8 md:text-sm">
      <Reveal client:load onMount x={-56} y={0} delay={0.18} duration={1.5} className="inline-block">
        <span>Brand Design ·</span>
      </Reveal>
      <Reveal client:load onMount x={0} y={0} delay={0.55} duration={1.8} className="inline-block">
        <span>Hospitality</span>
      </Reveal>
    </p>

    <Reveal client:load onMount x={-64} y={0} delay={0.35} duration={1.55}>
      <h1 class="font-display text-[clamp(2rem,5vw,3.85rem)] leading-[1.08] text-terracotta">
        Branding e identità <br />
        visiva per <em class="italic">l’hospitality</em>
      </h1>
    </Reveal>

    <Reveal client:load onMount x={-72} y={0} delay={0.55} duration={1.65} className="mt-8 md:mt-10">
      <div class="max-w-prose-lg space-y-3 font-display text-[clamp(0.95rem,1.5vw,1.2rem)] leading-snug text-olive md:space-y-4">
        <p>
          Miriana Studio è un{' '}
          <em class="font-bold italic">brand design studio</em>{' '}
          specializzato in branding, strategia e identità visiva per brand dell’hospitality.
        </p>
        <p>
          Progetto sistemi di identità che rendono più chiaro, coerente e riconoscibile il{' '}
          <em class="font-bold italic">valore di un brand.</em>
        </p>
      </div>
    </Reveal>
  </div>
</section>
